# Backend API — the frontend has no database, storage, email, or payment
# SDKs of its own anymore. Every data operation goes through this URL as a
# real HTTP call to the pepnetcom-backend service (see ../backend).
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Auth (NextAuth v5 / Auth.js) — session/cookie management only. Real
# credential verification happens on the backend; NextAuth here just holds
# the access/refresh tokens the backend issues inside its own JWT session.
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="CqEZ84PRtkyLgV2lXUdj+vfB8Afxwje5tYPAjIypLOw="
AUTH_SECRET="B/xqaV8LG755YLr98RKlbKdbjaFLY9Ho9Q8swWkLm+4="

# Google Identity Services — must match the backend's GOOGLE_CLIENT_ID
# exactly (an ID token is only valid for the client it was requested for).
# "Sign in with Google" is simply omitted from the UI if this is unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Set to "true" to redirect the entire site to /maintenance (see middleware.ts).
NEXT_PUBLIC_MAINTENANCE_MODE="false"
