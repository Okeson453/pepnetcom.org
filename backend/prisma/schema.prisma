generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE
// ==========================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  role          UserRole      @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false) @map("email_verified")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  /// Base32 TOTP secret — only set once setup is confirmed via a valid code (see auth.service.ts). Null while 2FA is off or mid-setup.
  twoFactorSecret     String?   @map("two_factor_secret")
  /// Bcrypt-hashed one-time backup codes; each is removed from the array once consumed.
  twoFactorBackupCodes String[] @default([]) @map("two_factor_backup_codes")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  sessions        Session[]
  orders          Order[]
  payments        Payment[]
  assignments     OrderAssignment[]
  messagesSent    Message[] @relation("SenderMessages")
  messagesReceived Message[] @relation("RecipientMessages")
  notifications   Notification[]
  supportTickets  SupportTicket[]
  ticketReplies   TicketReply[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
  strategyPurchases StrategyPurchase[]
  signalSubscriptions SignalSubscription[]
  consultations   ConsultationRequest[]
  studentApplications StudentApplication[]
  refundRequests  RefundRequest[]
  subscriptions   Subscription[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  refreshToken String @unique @map("refresh_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@map("sessions")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  module      String
  action      String

  roles RolePermission[]

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum UserRole {
  ADMIN
  CLIENT
  WRITER
  PUBLIC
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ==========================================
// ORDERS
// ==========================================
model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")
  clientId    String      @map("client_id")
  serviceType ServiceType @map("service_type")
  status      OrderStatus @default(DRAFT)
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency    String      @default("NGN")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  paidAt      DateTime?   @map("paid_at")
  completedAt DateTime?   @map("completed_at")

  client       User              @relation(fields: [clientId], references: [id])
  statusHistory OrderStatusHistory[]
  assignment   OrderAssignment?
  payment      Payment?
  invoice      Invoice?
  siwesDetail  SiwesOrderDetail?
  academicDetail AcademicOrderDetail?

  @@index([clientId])
  @@index([status])
  @@index([serviceType])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  status    OrderStatus
  notes     String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("order_status_history")
}

model OrderAssignment {
  id         String    @id @default(cuid())
  orderId    String    @unique @map("order_id")
  staffId    String    @map("staff_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String    @map("assigned_by")
  dueDate    DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff User  @relation(fields: [staffId], references: [id])

  @@index([orderId])
  @@index([staffId])
  @@map("order_assignments")
}

enum ServiceType {
  SIWES
  ACADEMIC
  TRADE_STRATEGY
  EDUCATION_CONSULTANT
  DIGITAL_MARKETING
  SIGNALS
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  ASSIGNED
  IN_PROGRESS
  UNDER_REVIEW
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  REFUNDED
}

// ==========================================
// SIWES
// ==========================================
model SiwesOrderDetail {
  id              String   @id @default(cuid())
  orderId         String   @unique @map("order_id")
  institutionName String   @map("institution_name")
  department      String?
  matricNumber    String?  @map("matric_number")
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  reportFormat    String   @default("standard") @map("report_format")
  supervisorName  String?  @map("supervisor_name")
  companyName     String?  @map("company_name")
  companyAddress  String?  @map("company_address")
  completedReportUrl String? @map("completed_report_url")
  uploadedAt      DateTime? @map("uploaded_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("siwes_order_details")
}

// ==========================================
// ACADEMIC
// ==========================================
model AcademicOrderDetail {
  id          String   @id @default(cuid())
  orderId     String   @unique @map("order_id")
  subjectId   String   @map("subject_id")
  topic       String
  wordCount   Int?     @map("word_count")
  citationStyle String? @default("APA") @map("citation_style")
  instructions  String?
  deadline    DateTime?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([subjectId])
  @@map("academic_order_details")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  academicOrders AcademicOrderDetail[]
  assignments    Assignment[]

  @@index([isActive])
  @@map("subjects")
}

model Assignment {
  id          String           @id @default(cuid())
  subjectId   String           @map("subject_id")
  title       String
  description String?
  status      AssignmentStatus @default(PENDING)
  dueDate     DateTime?        @map("due_date")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([subjectId])
  @@index([status])
  @@map("assignments")
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ==========================================
// TRADE
// ==========================================
model Strategy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  content     String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  category    String
  difficulty  String   @default("beginner")
  isActive    Boolean  @default(true) @map("is_active")
  downloadUrl String?  @map("download_url")
  previewUrl  String?  @map("preview_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchases StrategyPurchase[]

  @@index([isActive])
  @@index([category])
  @@index([slug])
  @@map("strategies")
}

model StrategyPurchase {
  id         String    @id @default(cuid())
  strategyId String    @map("strategy_id")
  userId     String    @map("user_id")
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("USD")
  // PENDING until the linked Payment verifies successfully; access to the
  // strategy must only be granted when status = ACTIVE. See
  // payments.service.ts::verifyPayment, which is the only code path allowed
  // to flip this to ACTIVE.
  status      StrategyPurchaseStatus @default(PENDING)
  purchasedAt DateTime? @map("purchased_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  strategy Strategy @relation(fields: [strategyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  payment  Payment?

  @@index([userId])
  @@index([strategyId])
  @@index([status])
  @@map("strategy_purchases")
}

enum StrategyPurchaseStatus {
  PENDING
  ACTIVE
  CANCELLED
  FAILED
}

// ==========================================
// EDUCATION
// ==========================================
model ConsultationRequest {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  fullName    String   @map("full_name")
  email       String
  phone       String?
  serviceType String   @map("service_type")
  message     String   @db.Text
  status      ConsultationStatus @default(PENDING)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("consultation_requests")
}

model StudentApplication {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  universityId  String   @map("university_id")
  countryId     String   @map("country_id")
  program       String
  intakeDate    DateTime @map("intake_date")
  status        ApplicationStatus @default(SUBMITTED)
  documents     Json?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  university University @relation(fields: [universityId], references: [id])
  country    Country    @relation(fields: [countryId], references: [id])

  @@index([userId])
  @@index([universityId])
  @@index([countryId])
  @@index([status])
  @@map("student_applications")
}

model University {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  countryId   String   @map("country_id")
  city        String?
  website     String?
  description String?  @db.Text
  ranking     Int?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  country       Country    @relation(fields: [countryId], references: [id])
  applications  StudentApplication[]

  @@index([countryId])
  @@index([isActive])
  @@map("universities")
}

model Country {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  flagUrl     String?  @map("flag_url")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  universities  University[]
  applications  StudentApplication[]

  @@index([isActive])
  @@map("countries")
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  DEFERRED
  ENROLLED
}

// ==========================================
// MARKETING
// ==========================================
model MarketingProject {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  name        String
  description String?  @db.Text
  status      ProjectStatus @default(ACTIVE)
  budget      Decimal? @db.Decimal(12, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client      User       @relation(fields: [clientId], references: [id])
  campaigns   Campaign[]
  reports     MarketingReport[]
  deliverables Deliverable[]

  @@index([clientId])
  @@index([status])
  @@map("marketing_projects")
}

model Campaign {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String?  @db.Text
  platform    String
  status      CampaignStatus @default(PLANNED)
  budget      Decimal? @db.Decimal(12, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  metrics     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project MarketingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("campaigns")
}

model MarketingReport {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  title       String
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  summary     String?  @db.Text
  metrics     Json?
  fileUrl     String?  @map("file_url")
  createdAt   DateTime @default(now()) @map("created_at")

  project MarketingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("marketing_reports")
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  title       String
  description String?  @db.Text
  fileUrl     String?  @map("file_url")
  fileType    String?  @map("file_type")
  fileSize    Int?     @map("file_size")
  status      DeliverableStatus @default(PENDING)
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project MarketingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("deliverables")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  APPROVED
  REJECTED
}

// ==========================================
// SIGNALS
// ==========================================
model Signal {
  id            String       @id @default(cuid())
  symbol        String
  type          SignalType
  direction     SignalDirection
  entryPrice    Decimal?     @map("entry_price") @db.Decimal(18, 8)
  stopLoss      Decimal?     @map("stop_loss") @db.Decimal(18, 8)
  takeProfit    Decimal?     @map("take_profit") @db.Decimal(18, 8)
  description   String?      @db.Text
  analysis      String?      @db.Text
  status        SignalStatus @default(ACTIVE)
  result        SignalResult?
  closedAt      DateTime?    @map("closed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  performances SignalPerformance[]

  @@index([symbol])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("signals")
}

model SignalSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  plan      String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("NGN")
  // See Subscription.status above — same PENDING-until-paid reasoning.
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  autoRenew Boolean  @default(true) @map("auto_renew")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("signal_subscriptions")
}

model SignalPerformance {
  id          String   @id @default(cuid())
  signalId    String   @map("signal_id")
  pips        Decimal? @db.Decimal(10, 2)
  percentage  Decimal? @db.Decimal(10, 4)
  rrRatio     Decimal? @map("rr_ratio") @db.Decimal(5, 2)
  duration    Int?     // minutes
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@map("signal_performances")
}

enum SignalType {
  FOREX
  CRYPTO
  STOCKS
  COMMODITIES
  INDICES
}

enum SignalDirection {
  BUY
  SELL
}

enum SignalStatus {
  ACTIVE
  CLOSED
  CANCELLED
  EXPIRED
}

enum SignalResult {
  WIN
  LOSS
  BREAK_EVEN
  PARTIAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

// ==========================================
// COMMERCE
// ==========================================
model Payment {
  id                 String   @id @default(cuid())
  // NOTE: intentionally NOT @unique. An order can have many payment *attempts*
  // (declined card, abandoned checkout, retry) but at most one SUCCESS. That
  // invariant is enforced at the DB level by a partial unique index applied in
  // migration 20260726000000_fix_audit_findings (see migrations dir), not by
  // a column-level constraint here, since Prisma has no native support for
  // partial unique indexes on a non-enum column condition.
  orderId            String?  @map("order_id")
  // Nullable target for "ad-hoc" payments not tied to an Order — currently
  // used for trade-strategy purchases so they go through the same verified
  // payment lifecycle as orders instead of granting access on request alone.
  strategyPurchaseId String?  @unique @map("strategy_purchase_id")
  // Same pattern for the two subscription types (§9.2 — previously neither
  // had any creation path that went through a real payment at all).
  subscriptionId       String?  @unique @map("subscription_id")
  signalSubscriptionId String?  @unique @map("signal_subscription_id")
  userId             String   @map("user_id")
  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @default("NGN")
  gateway            String
  gatewayRef         String?  @unique @map("gateway_ref")
  status             PaymentStatus @default(PENDING)
  metadata           Json?
  paidAt             DateTime? @map("paid_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  order            Order?            @relation(fields: [orderId], references: [id])
  strategyPurchase StrategyPurchase? @relation(fields: [strategyPurchaseId], references: [id])
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id])
  signalSubscription SignalSubscription? @relation(fields: [signalSubscriptionId], references: [id])
  // Pre-existing gap fixed while touching this model: userId had no formal
  // relation even though payments.service.ts has always used
  // `user: { connect: { id: userId } } }` when creating a Payment — that
  // wouldn't type-check against Prisma.PaymentCreateInput without this.
  user    User            @relation(fields: [userId], references: [id])
  refunds RefundRequest[]

  @@index([userId])
  @@index([status])
  @@index([gatewayRef])
  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id          String   @id @default(cuid())
  orderId     String   @unique @map("order_id")
  invoiceNumber String @unique @map("invoice_number")
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime @default(now()) @map("issued_at")
  dueDate     DateTime @map("due_date")
  paidAt      DateTime? @map("paid_at")
  fileUrl     String?  @map("file_url")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoices")
}

model RefundRequest {
  id          String   @id @default(cuid())
  paymentId   String   @map("payment_id")
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(PENDING)
  processedBy String?  @map("processed_by")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@map("refund_requests")
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  plan        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  interval    String   // monthly, yearly
  // PENDING until the linked Payment verifies — see payments.service.ts::verifyPayment.
  // Previously defaulted to ACTIVE, meaning a Subscription row existing at all
  // (created by whatever process, with no payment involved) WAS full access.
  status      SubscriptionStatus @default(PENDING)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  autoRenew   Boolean  @default(true) @map("auto_renew")
  gateway     String?
  gatewaySubId String? @map("gateway_sub_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  FLAGGED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// ==========================================
// CMS
// ==========================================
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @db.Text
  coverImage  String?  @map("cover_image")
  authorId    String   @map("author_id")
  categoryId  String?  @map("category_id")
  status      PostStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at")
  views       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("blog_posts")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  posts    BlogPost[]
  children Category[] @relation("CategoryParent")
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])

  @@index([slug])
  @@map("categories")
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  size        Int
  url         String
  folder      String   @default("uploads")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([folder])
  @@map("media_assets")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  content     String   @db.Text
  rating      Int      @default(5)
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isApproved])
  @@map("testimonials")
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  category String?
  order    Int    @default(0)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@map("faqs")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ==========================================
// COMMS
// ==========================================
model Message {
  id          String   @id @default(cuid())
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  content     String   @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  sender    User @relation("SenderMessages", fields: [senderId], references: [id])
  recipient User @relation("RecipientMessages", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  title       String
  body        String
  data        Json?
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  subject     String
  description String   @db.Text
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String
  assignedTo  String?  @map("assigned_to")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  isInternal Boolean @default(false) @map("is_internal")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_replies")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// PLATFORM
// ==========================================
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  keyHash   String   @unique @map("key_hash")
  scopes    String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("settings")
}

model GeneratedReport {
  id          String   @id @default(cuid())
  name        String
  type        String   // sales, signals, website, custom
  format      String   @default("csv")
  status      String   @default("generated")
  downloadUrl String?  @map("download_url")
  storageKey  String?  @map("storage_key")
  generatedBy String?  @map("generated_by")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([createdAt])
  @@map("generated_reports")
}

model DailyAnalyticsRollup {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  totalUsers    Int      @default(0) @map("total_users")
  newUsers      Int      @default(0) @map("new_users")
  totalOrders   Int      @default(0) @map("total_orders")
  totalRevenue  Decimal  @default(0) @db.Decimal(14, 2) @map("total_revenue")
  totalSignals  Int      @default(0) @map("total_signals")
  signalWinRate Decimal  @default(0) @db.Decimal(5, 2) @map("signal_win_rate")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("daily_analytics_rollups")
}

model DeadLetterJob {
  id          String   @id @default(cuid())
  queue       String
  jobId       String   @map("job_id")
  data        Json
  error       String
  resolved    Boolean  @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?  @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([queue])
  @@index([resolved])
  @@index([createdAt])
  @@map("dead_letter_jobs")
}

// ==========================================
// EVENTS / OUTBOX
// ==========================================
model OutboxEvent {
  id          String   @id @default(cuid())
  type        String
  payload     Json
  aggregateId String   @map("aggregate_id")
  status      OutboxStatus @default(PENDING)
  retryCount  Int      @default(0) @map("retry_count")
  error       String?
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([type])
  @@index([aggregateId])
  @@index([createdAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}
