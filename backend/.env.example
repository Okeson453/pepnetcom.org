NODE_ENV=development
PORT=3000
# 'all' runs HTTP + BullMQ workers + outbox relay + cron in one process
# (fine for local dev/single-instance). Use 'web' / 'worker' to split them
# in production — see src/server.ts.
PROCESS_ROLE=all

DATABASE_URL="postgresql://user:password@localhost:5432/pepnetcom"
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT_SECONDS=10
REDIS_URL="redis://localhost:6379"

JWT_SECRET="replace-with-a-real-32-plus-character-secret"
JWT_REFRESH_SECRET="replace-with-a-different-32-plus-character-secret"

S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="pepnetcom"
S3_REGION="auto"

# Payments — all optional individually, but a gateway with only some keys
# set will fail at the first real request, not at boot.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_HASH=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

RESEND_API_KEY=""

# Google Identity Services — must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly (an ID token is only valid for the
# client it was requested for). Google sign-in is simply unavailable if unset.
GOOGLE_CLIENT_ID=""

# CORS — FRONTEND_URL is always allowed. Add Vercel preview URLs, a staging
# domain, etc. here as a comma-separated list rather than widening this to
# '*' (which credentials:true forbids anyway — see cors.ts).
FRONTEND_URL="http://localhost:3001"
ADDITIONAL_CORS_ORIGINS=""

# Only set true when actually deployed behind a reverse proxy/LB that sets
# X-Forwarded-For/X-Real-IP authoritatively and strips client-supplied
# values — see rate-limiter.ts. Leave false for local dev.
TRUST_PROXY=false

# SMS (Termii — Nigeria-focused)
TERMII_API_KEY=""
TERMII_SENDER_ID="PEPNETCOM"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Push notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# Optional — dead-lettered background jobs post here if set (Slack/Discord/
# any incoming-webhook-compatible URL accepting { text }). No-op if unset.
ALERT_WEBHOOK_URL=""
