# Dummy-but-schema-valid values for running the test suite (unit tests mock
# the repository layer; only true integration tests need a real Postgres/
# Redis reachable at these URLs). No real secrets here — safe to commit.
# Bun automatically loads this file for `bun test` (NODE_ENV defaults to
# "test" for that command); see vitest.config.ts for the vitest equivalent.
NODE_ENV=test
PORT=3000
PROCESS_ROLE=all

DATABASE_URL=postgresql://test:test@localhost:5432/pepnetcom_test
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-jwt-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters

S3_ENDPOINT=https://test.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-key
S3_BUCKET_NAME=pepnetcom-test
S3_REGION=auto

FRONTEND_URL=http://localhost:3001
ADDITIONAL_CORS_ORIGINS=
TRUST_PROXY=false
